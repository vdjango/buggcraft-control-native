{
  "listen": "127.0.0.1",
  "port": 8443,
  "tls_certificate": "secrets/tls-chain.pem",
  "tls_key": "secrets/tls-key.pem",
  "signing_key": "secrets/signing-ed25519.pem",
  "database_file": "secrets/database.conninfo",
  "admin_token_file": "secrets/admin-token",
  "schema_file": "sql/001-initial.sql",
  "audience": "buggcraft-control-v1",
  "json_implementation": "auto",
  "io_threads": 2,
  "workers": 4,
  "queue_limit": 128,
  "max_connections": 512,
  "grant_seconds": 900,
  "node_lease_seconds": 20,
  "player_lease_seconds": 30,
  "reservation_seconds": 30,
  "heartbeat_limit": 120,
  "candidate_limit": 8,
  "node_slot_limit": 2048,
  "node_bandwidth_limit": 1000000000,
  "allowed_pools": ["official"],
  "region_routes": {"cn-south": ["cn-east"], "cn-east": ["cn-south"]},
  "allow_loopback_nodes": false
}
